{
  "name": "extension-a11y-checker",
  "author": {
    "name": "Lukas Fritze",
    "email": "l.fritze@mittwald.de"
  },
  "packageManager": "yarn@4.6.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "nx run-many --targets=lint",
    "lint:fix": "nx run-many --target=lint:fix",
    "format": "nx run-many --target=format",
    "format:check": "nx run-many --target=format:check",
    "typecheck": "nx run-many --target=typecheck",
    "test": "nx run-many --target=test",
    "dev": "yarn workspaces foreach --all --interlaced --parallel run dev",
    "build": "nx run-many --target=build",
    "start": "nx run-many --target=start",
    "compile": "yarn build"
  },
  "devDependencies": {
    "@nx/eslint": "23.1.2",
    "@nx/vite": "23.1.2",
    "@nx/web": "23.1.2",
    "@vitest/ui": "^4.1.11",
    "nx": "23.1.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
